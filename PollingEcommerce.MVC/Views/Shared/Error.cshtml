@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<section class="error-panel glass-panel text-center">
    <div class="error-symbol" aria-hidden="true">!</div>
    <span class="eyebrow">SOMETHING WENT WRONG</span>
    <h1>We could not complete that request</h1>
    <p>Please return to the store and try again. If the issue continues, keep the reference below for support.</p>
    @if (Model.ShowRequestId)
    {
        <code class="request-id">Reference: @Model.RequestId</code>
    }
    <div><a asp-controller="Home" asp-action="Index" class="btn btn-primary">Return to store</a></div>
</section>
