@model PollingEcommerce.MVC.Models.OrderViewModel
@{ ViewData["Title"] = "Payment status"; }
<div class="status-panel mx-auto text-center rounded-4 shadow-sm p-5"><div id="spinner" class="spinner-border text-primary mb-4"></div><h1 id="title" class="h2">Confirming your payment</h1><p id="message" class="text-secondary">Keep this page open. We are checking safely with the store API.</p><dl class="row text-start mt-4"><dt class="col-5">Order</dt><dd class="col-7 text-break">@Model.OrderNumber</dd><dt class="col-5">Order status</dt><dd class="col-7" id="order-status">PendingPayment</dd><dt class="col-5">Payment status</dt><dd class="col-7" id="payment-status">Pending</dd><dt class="col-5">Total</dt><dd class="col-7" id="total">—</dd></dl><a href="/" class="btn btn-outline-primary mt-3">Back to store</a></div>
@section Scripts { <script>const order='@Model.OrderNumber';async function poll(){try{const r=await fetch(`/Home/OrderStatus?orderNumber=${order}`);const x=await r.json();document.querySelector('#order-status').textContent=x.orderStatus;document.querySelector('#payment-status').textContent=x.paymentStatus;document.querySelector('#total').textContent=Number(x.totalAmount).toLocaleString()+' MMK';if(x.orderStatus==='Paid'){done('Payment confirmed','Your order is confirmed. Thank you!','text-success');return}if(x.orderStatus==='PaymentFailed'){done('Payment failed',x.failureReason||'The payment could not be completed.','text-danger');return}}catch{}setTimeout(poll,2000)}function done(t,m,c){document.querySelector('#spinner').classList.add('d-none');const e=document.querySelector('#title');e.textContent=t;e.classList.add(c);document.querySelector('#message').textContent=m}poll();</script> }
